# Linear personal API key (Settings → Security & access → Personal API keys). Used only by the launcher's poll.
LINEAR_API_KEY=
# Optional: GitHub token for git fetch/push in sessions (write it with: printf 'GH_TOKEN=%s\n' "$(gh auth token)" >> .env).
GH_TOKEN=
# Optional: Slack user token (xoxp-…, scope files:write) for sending files as native attachments: create a Slack app,
# add files:write under User Token Scopes, install it to your workspace and copy the User OAuth Token.
SLACK_USER_TOKEN=
